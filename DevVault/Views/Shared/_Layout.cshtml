<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - DevVault
    </title>


    <!-- Bootstrap -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">


    <!-- Bootstrap Icons -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">


    <!-- DevVault CSS -->

    <link rel="stylesheet"
          href="~/css/site.css" asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/formatters.css" asp-append-version="true"  />

    <link rel="stylesheet"
          href="~/css/jwt.css" />

    <link rel="stylesheet"
          href="~/css/regex-tester.css" asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/api-tester.css" asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/markdown-preview.css" asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/color-tool.css" asp-append-version="true"  />

    <link rel="stylesheet"
          href="~/css/snippets.css" asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/uuid-generator.css" asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/base64_des.css" asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/hash_file.css" asp-append-version="true" />
    
    @RenderSection("Styles", required: false)
</head>


<body>


    <!-- =====================================================
         NAVBAR
    ====================================================== -->

    <nav class="navbar dev-navbar fixed-top">

        <div class="container-fluid">


            <!-- Mobile Sidebar Button -->

            <button class="sidebar-toggle d-lg-none"
                    type="button"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#mobileSidebar">

                <i class="bi bi-list"></i>

            </button>


            <!-- DevVault Logo -->

            <a class="dev-logo"
               asp-controller="Home"
               asp-action="Index">

                <div class="logo-icon">

                    <i class="bi bi-boxes"></i>

                </div>

                <span>
                    DevVault
                </span>

            </a>


            <!-- Navbar Search -->

            @* <div class="navbar-search d-none d-md-flex">

                <i class="bi bi-search"></i>

                <input type="text"
                       placeholder="Search tools..." />

                <span>
                    Ctrl K
                </span>

            </div> *@


            <!-- Navbar Actions -->

            <div class="navbar-actions ms-auto">


                <!-- Theme -->

                <button class="nav-icon-btn"
                        id="themeToggle"
                        type="button"
                        aria-label="Toggle theme">

                    <i class="bi bi-sun-fill"
                       id="themeIcon"></i>

                </button>


                <!-- Settings -->

                @* <a href="#"
                   class="nav-icon-btn">

                    <i class="bi bi-gear"></i>

                </a>


                <!-- Divider -->

                <div class="nav-divider"></div>


                <!-- Profile -->

                <button class="profile-btn">

                    <div class="profile-avatar">
                        R
                    </div>

                </button> *@

            </div>

        </div>

    </nav>



    <!-- =====================================================
         DESKTOP SIDEBAR
    ====================================================== -->

    <aside class="dev-sidebar d-none d-lg-flex">


        <!-- Dashboard -->

        <div class="sidebar-main">
            <a class="sidebar-link active"
               asp-controller="Home"
               asp-action="Index">

                <i class="bi bi-grid-1x2"></i>

                <span>
                    Dashboard
                </span>

            </a>


            <!-- =============================================
                 CODE
            ============================================== -->

            <div class="sidebar-group">

                <div class="sidebar-heading">

                    <span>
                        CODE
                    </span>

                </div>


                <a class="sidebar-link"
                   asp-controller="Snippets"
                   asp-action="Index">

                    <i class="bi bi-code-square"></i>

                    <span>
                        Snippets
                    </span>

                </a>


                <a class="sidebar-link"
                   asp-controller="Formatter"
                   asp-action="Index">
                   @* href="/Formatter"> *@

                    <i class="bi bi-braces"></i>

                    <span>
                        Formatter
                    </span>

                </a>

            </div>


            <!-- =============================================
                 UTILITIES
            ============================================== -->

            <div class="sidebar-group">

                <div class="sidebar-heading">

                    <span>
                        UTILITIES
                    </span>

                </div>


                <a class="sidebar-link"
                   asp-controller="UUID"
                   asp-action="Index">
                   @* href="/UUID"> *@

                    <i class="bi bi-fingerprint"></i>

                    <span>
                        UUID
                    </span>

                </a>


                <a class="sidebar-link"
                   asp-controller="Base64Tool"
                   asp-action="Index">
                   @* href="/Base64Tool"> *@

                    <i class="bi bi-file-lock"></i>

                    <span>
                        Base64
                    </span>

                </a>


                <a class="sidebar-link"
                   asp-controller="Hash"
                   asp-action="Index">
                   @* href="/Hash"> *@

                    <i class="bi bi-hash"></i>

                    <span>
                        Hash
                    </span>

                </a>


                @* <a class="sidebar-link"
                   href="#">

                    <i class="bi bi-clock"></i>

                    <span>
                        Timestamp
                    </span> *@

                </a>

            </div>


            <!-- =============================================
                 AI
            ============================================== -->

            @* <div class="sidebar-group">

                <div class="sidebar-heading">

                    <span>
                        AI
                    </span>

                </div>


                <a class="sidebar-link"
                   href="/AI">

                    <i class="bi bi-stars"></i>

                    <span>
                        Assistant
                    </span>

                </a>

            </div> *@

        </div>


        <!-- =============================================
             SETTINGS
        ============================================== -->

        @* <div class="sidebar-bottom">

            <a class="sidebar-link"
               href="#">

                <i class="bi bi-gear"></i>

                <span>
                    Settings
                </span>

            </a>

        </div> *@

    </aside>



    <!-- =====================================================
         MOBILE SIDEBAR
    ====================================================== -->

    <div class="offcanvas offcanvas-start mobile-sidebar"
         tabindex="-1"
         id="mobileSidebar">


        <!-- Mobile Sidebar Header -->

        <div class="offcanvas-header">

            <a class="dev-logo">

                <div class="logo-icon">

                    <i class="bi bi-boxes"></i>

                </div>

                <span>
                    DevVault
                </span>

            </a>


            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="offcanvas">
            </button>

        </div>


        <!-- Mobile Sidebar Body -->

        <div class="offcanvas-body">


            <!-- Dashboard -->

            <a class="sidebar-link active"
               asp-controller="Home"
               asp-action="Index">

                <i class="bi bi-grid-1x2"></i>

                <span>
                    Dashboard
                </span>

            </a>


            <!-- CODE -->

            <div class="sidebar-group">

                <div class="sidebar-heading">
                    CODE
                </div>


                <a class="sidebar-link"
                   asp-controller="Snippets"
                   asp-action="Index">
                   @* href="/Snippets"> *@

                    <i class="bi bi-code-square"></i>

                    <span>
                        Snippets
                    </span>

                </a>


                <a class="sidebar-link"
               asp-controller="Formatter"
               asp-action="Index">
                   @* href="/Formatter"> *@

                    <i class="bi bi-braces"></i>

                    <span>
                        Formatter
                    </span>

                </a>

            </div>


            <!-- UTILITIES -->

            <div class="sidebar-group">

                <div class="sidebar-heading">
                    UTILITIES
                </div>


                <a class="sidebar-link"
                   asp-controller="UUID"
                   asp-action="Index">
                   @* href="/UUID"> *@

                    <i class="bi bi-fingerprint"></i>

                    <span>
                        UUID
                    </span>

                </a>


                <a class="sidebar-link"
               asp-controller="Base64Tool"
               asp-action="Index">
                   @* href="/Base64Tool"> *@

                    <i class="bi bi-file-lock"></i>

                    <span>
                        Base64
                    </span>

                </a>


                <a class="sidebar-link"
               asp-controller="Hash"
               asp-action="Index">
                   @* href="/Hash"> *@

                    <i class="bi bi-hash"></i>

                    <span>
                        Hash
                    </span>

                </a>


                @* <a class="sidebar-link"
                   href="#">

                    <i class="bi bi-clock"></i>

                    <span>
                        Timestamp
                    </span>

                </a> *@

            </div>


            <!-- AI -->

            @* <div class="sidebar-group">

                <div class="sidebar-heading">
                    AI
                </div>


                <a class="sidebar-link"
                   href="/AI">

                    <i class="bi bi-stars"></i>

                    <span>
                        Assistant
                    </span>

                </a>

            </div> *@


            <!-- SETTINGS -->

            @* <div class="sidebar-group">

                <a class="sidebar-link"
                   href="#">

                    <i class="bi bi-gear"></i>

                    <span>
                        Settings
                    </span>

                </a>

            </div> *@

        </div>

    </div>



    <!-- =====================================================
         MAIN CONTENT
    ====================================================== -->

    <main class="dev-main">

        @RenderBody()

    </main>



    <!-- Bootstrap JS -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    <!-- DevVault JS -->

    <script src="~/js/site.js">
    </script>   

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>