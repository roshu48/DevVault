@{
    ViewData["Title"] = "JSON Formatter";
}

<div class="formatter-page">

    <!-- =========================================
     FORMATTER HEADER
========================================== -->

    <div class="formatter-header">

        <div>
            <div class="formatter-breadcrumb">
                <a style="color:gray; cursor:pointer; text-decoration:none" href="/">Developer Tools</a>
                <i class="bi bi-chevron-right"></i>
                <span class="active">Formatters</span>
            </div>

            <h1>
                JSON Formatter
            </h1>

            <p>
                Format, validate and beautify JSON data quickly and easily.
            </p>
        </div>

    </div>


    <!-- =========================================
     FORMATTER TYPES
========================================== -->

    <section class="formatter-section">

        <div class="formatter-section-header">

            <div>
                <h2>
                    Formatters
                </h2>

                <p>
                    Choose a formatter for your development needs.
                </p>
            </div>

            <span class="formatter-count">
                8 Tools
            </span>

        </div>


        <div class="formatter-grid">


            <!-- JSON -->

            <a href="/Formatter/Tool?type=json"
               class="formatter-card active">

                <div class="formatter-card-icon json-formatter-icon">
                    <i class="bi bi-braces"></i>
                </div>

                <div class="formatter-card-content">

                    <h3>
                        JSON Formatter
                    </h3>

                    <p>
                        Format and validate JSON data.
                    </p>

                </div>

                <i class="bi bi-chevron-right formatter-card-arrow"></i>

            </a>


            <!-- SQL -->

            <a href="/Formatter/Tool?type=sql"
               class="formatter-card">

                <div class="formatter-card-icon sql-formatter-icon">
                    <i class="bi bi-database"></i>
                </div>

                <div class="formatter-card-content">

                    <h3>
                        SQL Formatter
                    </h3>

                    <p>
                        Format and beautify SQL queries.
                    </p>

                </div>

                <i class="bi bi-chevron-right formatter-card-arrow"></i>

            </a>


            <!-- JavaScript -->

            <a href="/Formatter/Tool?type=javascript"
               class="formatter-card">

                <div class="formatter-card-icon javascript-formatter-icon">
                    <i class="bi bi-filetype-js"></i>
                </div>

                <div class="formatter-card-content">

                    <h3>
                        JavaScript Formatter
                    </h3>

                    <p>
                        Format and clean JavaScript code.
                    </p>

                </div>

                <i class="bi bi-chevron-right formatter-card-arrow"></i>

            </a>


            <!-- HTML -->

            <a href="/Formatter/Tool?type=html"
               class="formatter-card">

                <div class="formatter-card-icon html-formatter-icon">
                    <i class="bi bi-filetype-html"></i>
                </div>

                <div class="formatter-card-content">

                    <h3>
                        HTML Formatter
                    </h3>

                    <p>
                        Format and organize HTML markup.
                    </p>

                </div>

                <i class="bi bi-chevron-right formatter-card-arrow"></i>

            </a>


            <!-- CSS -->

            <a href="/Formatter/Tool?type=css"
               class="formatter-card">

                <div class="formatter-card-icon css-formatter-icon">
                    <i class="bi bi-filetype-css"></i>
                </div>

                <div class="formatter-card-content">

                    <h3>
                        CSS Formatter
                    </h3>

                    <p>
                        Format and beautify CSS stylesheets.
                    </p>

                </div>

                <i class="bi bi-chevron-right formatter-card-arrow"></i>

            </a>


            <!-- XML -->

            <a href="/Formatter/Tool?type=xml"
               class="formatter-card">

                <div class="formatter-card-icon xml-formatter-icon">
                    <i class="bi bi-code-slash"></i>
                </div>

                <div class="formatter-card-content">

                    <h3>
                        XML Formatter
                    </h3>

                    <p>
                        Format and structure XML documents.
                    </p>

                </div>

                <i class="bi bi-chevron-right formatter-card-arrow"></i>

            </a>


            <!-- C# -->

            <a href="/Formatter/Tool?type=csharp"
               class="formatter-card">

                <div class="formatter-card-icon csharp-formatter-icon">
                    <i class="bi bi-filetype-cs"></i>
                </div>

                <div class="formatter-card-content">

                    <h3>
                        C# Formatter
                    </h3>

                    <p>
                        Format and organize C# source code.
                    </p>

                </div>

                <i class="bi bi-chevron-right formatter-card-arrow"></i>

            </a>


            <!-- Java -->

            <a href="/Formatter/Tool?type=java"
               class="formatter-card">

                <div class="formatter-card-icon java-formatter-icon">
                    <i class="bi bi-filetype-java"></i>
                </div>

                <div class="formatter-card-content">

                    <h3>
                        Java Formatter
                    </h3>

                    <p>
                        Format and clean Java source code.
                    </p>

                </div>

                <i class="bi bi-chevron-right formatter-card-arrow"></i>

            </a>

        </div>

    </section>


   
</div>
