@{
    ViewData["Title"] = "View Snippet";
}

<div class="snippets-page">

    <!-- ==========================================
         BREADCRUMB
    =========================================== -->

    <div class="snippets-breadcrumb mb-3">

        <a asp-controller="Home"
           asp-action="Index">
            Developer Tools
        </a>

        <i class="bi bi-chevron-right mx-2"></i>

        <a asp-controller="Snippets"
           asp-action="Index">
            Snippets
        </a>

        <i class="bi bi-chevron-right mx-2"></i>

        <span id="breadcrumbTitle">
            View Snippet
        </span>

    </div>


    <!-- ==========================================
         TOP ACTIONS
    =========================================== -->

    <div class="snippet-view-top">

        <a asp-controller="Snippets"
           asp-action="Index"
           @* class="snippet-back-btn" *@
        >

            @* <i class="bi bi-arrow-left"></i> *@
            

        </a>


        <div class="snippet-view-actions">

            <button type="button"
                    id="editSnippet"
                    class="btn btn-outline-secondary">

                <i class="bi bi-pencil me-1"></i>
                Edit

            </button>

            <button type="button"
                    id="deleteSnippet"
                    class="btn btn-outline-danger" onclick="DelSnippets()">

                <i class="bi bi-trash me-1"></i>
                Delete
            </button>

        </div>

    </div>


    <!-- ==========================================
         SNIPPET INFORMATION
    =========================================== -->

    <div class="card snippet-view-info shadow-sm">

        <div class="card-body">

            <div class="d-flex justify-content-between
                align-items-start gap-3">

                <div>

                    <h1 id="snippetTitle"
                        class="snippet-view-title">
                        Snippet
                    </h1>

                    <div class="snippet-view-meta">

                        <span class="badge snippet-language"
                              id="snippetLanguage">
                        </span>

                        <span>
                            <i class="bi bi-clock me-1"></i>
                            <span id="snippetDate"></span>
                        </span>

                    </div>

                </div>

            </div>


            <!-- TAGS -->

            <div id="snippetTags"
                 class="snippet-tags mt-3">
            </div>


            <!-- DESCRIPTION -->

            <p id="snippetDescription"
               class="snippet-view-description mt-3 mb-0">
            </p>

        </div>

    </div>


    <!-- ==========================================
         CODE
    =========================================== -->

    <div class="card snippet-view-code shadow-sm mt-4">

        <!-- CODE HEADER -->

        <div class="snippet-view-code-header">

            <div class="snippet-code-language">

                <i class="bi bi-braces"></i>

                <span id="codeLanguage">
                    Code
                </span>

            </div>


            <button type="button"
                    id="copyCode"
                    class="btn btn-sm btn-outline-secondary">

                <i class="bi bi-copy me-1"></i>
                Copy Code

            </button>

        </div>


        <!-- CODE BODY -->

        <div class="snippet-view-code-body">

            <pre><code id="snippetCode"></code></pre>

        </div>

    </div>


    <!-- ==========================================
         NOT FOUND
    =========================================== -->

    <div id="snippetNotFound"
         class="d-none text-center py-5">

        <div class="empty-icon mb-3">

            <i class="bi bi-code-slash"></i>

        </div>

        <h5>
            Snippet not found
        </h5>

        <p>
            This snippet may have been deleted.
        </p>

        <a asp-controller="Snippets"
           asp-action="Index"
           class="btn btn-primary">

            Back to Snippets

        </a>

    </div>

</div>


@section Scripts {

    <script src="~/js/ViewSnippet.js"></script>

}