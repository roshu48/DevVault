@{
    ViewData["Title"] = "Snippets";
}

<div class="snippets-page">

    <!-- =========================
         HEADER
    ========================== -->
    <div class="snippets-header">

        <div class="snippets-breadcrumb mb-2">
            <a asp-controller="Home"
               asp-action="Index"
                @* href="/"  *@
                class="text-decoration-none">
                Developer Tools
            </a>

            <i class="bi bi-chevron-right mx-2"></i>

            <span>Snippets</span>
        </div>

        <div class="d-flex flex-column flex-md-row
            justify-content-between align-items-md-center gap-3">

            <div>
                <h1 class="snippets-title mb-1">
                    Code Snippets
                </h1>

                <p class="snippets-subtitle mb-0">
                    Save and reuse your frequently used code.
                </p>
            </div>

            <a asp-controller="Snippets"
               asp-action="CreateSnippets"
                @* href="/Snippets/CreateSnippets" *@
            >
                <button type="button"
                        class="btn btn-primary snippets-new-btn"
                        id="newSnippetBtn">

                    <i class="bi bi-plus-lg me-2"></i>
                    New Snippet
                </button>
            </a>

        </div>
    </div>


    <!-- =========================
         TOOLBAR
    ========================== -->
    @* <div class="card snippets-toolbar shadow-sm mb-4">

        <div class="card-body">

            <div class="row g-3 align-items-center">

                <!-- SEARCH -->
                <div class="col-12 col-lg-7">

                    <div class="input-group snippets-search">

                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>

                        <input type="text"
                               id="snippetSearch"
                               class="form-control"
                               placeholder="Search snippets..."
                               autocomplete="off" />

                    </div>

                </div>


                <!-- SORT -->
                <div class="col-12 col-sm-6 col-lg-3">

                    <select class="form-select snippets-sort"
                            id="snippetSort">

                        <option value="recent">
                            Recently Added
                        </option>

                        <option value="oldest">
                            Oldest
                        </option>

                        <option value="name">
                            Name
                        </option>

                    </select>

                </div>


                <!-- VIEW -->
                <div class="col-12 col-sm-6 col-lg-2">

                    <div class="btn-group w-100"
                         role="group">

                        <button type="button"
                                class="btn btn-outline-secondary active"
                                id="gridViewBtn"
                                title="Grid View">

                            <i class="bi bi-grid-3x3-gap"></i>

                        </button>

                        <button type="button"
                                class="btn btn-outline-secondary"
                                id="listViewBtn"
                                title="List View">

                            <i class="bi bi-list"></i>

                        </button>

                    </div>

                </div>

            </div>

        </div>
    </div>


    <!-- =========================
         CATEGORY FILTER
    ========================== -->
    <div class="snippets-categories">

        <div class="d-flex align-items-center
            gap-2 flex-wrap">

            <span class="category-label">
                Categories:
            </span>

            <button class="btn btn-sm category-btn active"
                    data-category="all">
                All
            </button>

            <button class="btn btn-sm category-btn"
                    data-category="C#">
                C#
            </button>

            <button class="btn btn-sm category-btn"
                    data-category="Java">
                Java
            </button>

            <button class="btn btn-sm category-btn"
                    data-category="JavaScript">
                JavaScript
            </button>

            <button class="btn btn-sm category-btn"
                    data-category="SQL">
                SQL
            </button>

            <button class="btn btn-sm category-btn"
                    data-category="React">
                React
            </button>

            <button class="btn btn-sm category-btn"
                    data-category="CSS">
                CSS
            </button>

        </div>

    </div> *@


