    <div id="snippetsContainer" class="row g-4">
        <div id="noSnippets" class="col-12 d-none">
            <div class="snippets-empty text-center py-5">
                <div class="empty-icon mb-3">
                    <i class="bi bi-code-slash"></i>
                </div>

