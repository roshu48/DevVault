                            #javascript
                        </span>

                        <span class="badge snippet-tag">
                            #utility
                        </span>

                    </div>


                    <div class="snippet-preview mb-3">

                        <pre><code>function debounce(fn, delay) {
    let timer;

    return (...args) => {
        clearTimeout(timer);
        timer = setTimeout(
            () => fn(...args),
            delay
        );
    };
}</code></pre>

                    </div>


                    <div class="snippet-footer mt-auto">

                        <div class="snippet-date mb-3">

                            <i class="bi bi-clock me-1"></i>
